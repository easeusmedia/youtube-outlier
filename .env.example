# Required. Create one free at https://console.cloud.google.com/apis/credentials
# (enable "YouTube Data API v3" for the project first). 10,000 units/day free —
# loading a 500-video channel costs about 21 units.
YOUTUBE_API_KEY=
# (API_KEY also works, in case that is what the host already has set.)

PORT=3100

# Safety cap on how many uploads to pull from one channel.
MAX_VIDEOS=2000

# Optional but required in practice on any cloud host: YouTube bot-blocks
# datacenter IPs, so direct caption fetching fails there. Apify runs through
# residential proxies. Comma-separated, tried in order so a token that runs
# out of credit rolls over to the next one.
APIFY_TOKENS=
